---
/**
 * Cookie consent + PostHog for cvt.co.ug only.
 * Loads analytics only after "accepted". Preference key matches the Next.js app banner.
 */
import {
  CVT_COOKIE_MAX_AGE_SECONDS,
  CVT_COOKIE_PREFERENCE_KEY,
  getPostHogHost,
  getPostHogKey,
  isPostHogConfigured,
} from "../../lib/cvt-analytics";
import { cvtPublicAppUrl } from "../../lib/site";

const posthogKey = getPostHogKey();
const posthogHost = getPostHogHost();
const configured = isPostHogConfigured();
const cookiesPolicyUrl = `${cvtPublicAppUrl}/en/support/cookies`;
---

{
  configured && (
    <>
    <section
      id="cvt-cookie-banner"
      class="cvt-cookie-banner"
      aria-label="Cookies on CVT Uganda"
      hidden
    >
      <div class="cvt-cookie-banner__inner">
        <div class="cvt-cookie-banner__copy">
          <h2 class="cvt-cookie-banner__title">Cookies on CVT Uganda</h2>
          <p>
            We use essential cookies so the site works. With your permission, we also use optional
            analytics (PostHog) to understand device types, pages visited, time on site, and visit
            patterns so we can improve cvt.co.ug.
          </p>
          <p>
            You can reject analytics and still use the site.{" "}
            <a href={cookiesPolicyUrl} target="_blank" rel="noopener">Cookie policy</a>
          </p>
        </div>
        <div class="cvt-cookie-banner__actions">
          <button type="button" class="cvt-cookie-banner__btn cvt-cookie-banner__btn--primary" data-cvt-cookie="accept">
            Accept analytics
          </button>
          <button type="button" class="cvt-cookie-banner__btn" data-cvt-cookie="reject">
            Reject analytics
          </button>
        </div>
      </div>
    </section>

<script
  is:inline
  define:vars={{
    preferenceKey: CVT_COOKIE_PREFERENCE_KEY,
    maxAge: CVT_COOKIE_MAX_AGE_SECONDS,
    posthogKey,
    posthogHost,
    configured,
  }}
>
  (function () {
    if (!configured || !posthogKey) return;

    var STORAGE_KEY = preferenceKey;
    var posthogStarted = false;

    function readPreference() {
      try {
        var localValue = window.localStorage.getItem(STORAGE_KEY);
        if (localValue) return localValue;
      } catch (e) {}

      var parts = document.cookie.split("; ");
      for (var i = 0; i < parts.length; i++) {
        if (parts[i].indexOf(STORAGE_KEY + "=") === 0) {
          return decodeURIComponent(parts[i].slice(STORAGE_KEY.length + 1));
        }
      }
      return null;
    }

    function cookieDomain() {
      var host = window.location.hostname;
      if (host === "cvt.co.ug" || host.endsWith(".cvt.co.ug")) return "; domain=.cvt.co.ug";
      return "";
    }

    function persistPreference(value) {
      try {
        window.localStorage.setItem(STORAGE_KEY, value);
      } catch (e) {}
      document.cookie =
        STORAGE_KEY +
        "=" +
        encodeURIComponent(value) +
        "; path=/" +
        cookieDomain() +
        "; max-age=" +
        maxAge +
        "; SameSite=Lax";
    }

    function startPostHog() {
      if (posthogStarted) return;
      posthogStarted = true;

      !(function (t, e) {
        var o, n, p, r;
        e.__SV ||
          ((window.posthog = e),
          (e._i = []),
          (e.init = function (i, s, a) {
            function g(t, e) {
              var o = e.split(".");
              2 == o.length && ((t = t[o[0]]), (e = o[1]));
              t[e] = function () {
                t.push([e].concat(Array.prototype.slice.call(arguments, 0)));
              };
            }
            ((p = t.createElement("script")).type = "text/javascript"),
              (p.async = !0),
              (p.src = s.api_host + "/static/array.js"),
              (r = t.getElementsByTagName("script")[0]).parentNode.insertBefore(p, r);
            var u = e;
            for (
              void 0 !== a ? (u = e[a] = []) : (a = "posthog"),
                u.people = u.people || [],
                u.toString = function (t) {
                  var e = "posthog";
                  return "posthog" !== a && (e += "." + a), t || (e += " (stub)"), e;
                },
                u.people.toString = function () {
                  return u.toString(1) + ".people (stub)";
                },
                o =
                  "init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(
                    " ",
                  ),
                n = 0;
              n < o.length;
              n++
            )
              g(u, o[n]);
            e._i.push([i, s, a]);
          }),
          (e.__SV = 1));
      })(document, window.posthog || []);

      window.posthog.init(posthogKey, {
        api_host: posthogHost,
        ui_host: posthogHost.replace(".i.posthog.com", ".posthog.com"),
        person_profiles: "identified_only",
        capture_pageview: true,
        capture_pageleave: true,
        persistence: "localStorage+cookie",
      });
    }

    function hideBanner() {
      var el = document.getElementById("cvt-cookie-banner");
      if (el) el.hidden = true;
    }

    function showBanner() {
      var el = document.getElementById("cvt-cookie-banner");
      if (el) el.hidden = false;
    }

    function onReady() {
      var preference = readPreference();
      if (preference === "accepted") {
        startPostHog();
        hideBanner();
        return;
      }
      if (preference === "rejected") {
        hideBanner();
        return;
      }
      showBanner();
    }

    document.addEventListener("click", function (event) {
      var target = event.target;
      if (!target || !target.getAttribute) return;
      var action = target.getAttribute("data-cvt-cookie");
      if (action === "accept") {
        persistPreference("accepted");
        startPostHog();
        hideBanner();
      } else if (action === "reject") {
        persistPreference("rejected");
        hideBanner();
      }
    });

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", onReady);
    } else {
      onReady();
    }
  })();
</script>

<style>
  .cvt-cookie-banner {
    position: fixed;
    z-index: 80;
    left: 0;
    right: 0;
    bottom: 0;
    border-top: 1px solid rgba(27, 25, 56, 0.12);
    background: #fff;
    box-shadow: 0 -8px 32px rgba(27, 25, 56, 0.08);
    padding: 1rem 1.25rem calc(1rem + env(safe-area-inset-bottom));
  }

  .cvt-cookie-banner__inner {
    margin: 0 auto;
    max-width: 56rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .cvt-cookie-banner__inner {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1.5rem;
    }
  }

  .cvt-cookie-banner__title {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: #1b1938;
  }

  .cvt-cookie-banner__copy {
    font-size: 0.925rem;
    line-height: 1.5;
    color: #4a4768;
  }

  .cvt-cookie-banner__copy p {
    margin: 0 0 0.5rem;
  }

  .cvt-cookie-banner__copy a {
    color: #5b4dff;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cvt-cookie-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .cvt-cookie-banner__btn {
    border: 1px solid rgba(27, 25, 56, 0.18);
    background: #fff;
    color: #1b1938;
    border-radius: 999px;
    padding: 0.55rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .cvt-cookie-banner__btn--primary {
    border-color: #5b4dff;
    background: #5b4dff;
    color: #fff;
  }

  .cvt-cookie-banner__btn:hover {
    filter: brightness(0.97);
  }
</style>
    </>
  )
}
